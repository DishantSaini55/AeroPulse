generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceRole {
  PRIMARY
  SECONDARY
}

enum DeviceHealth {
  HEALTHY
  DEGRADED
  UNAVAILABLE
  RECOVERING
}

enum ActivationState {
  ACTIVE
  STANDBY
  INELIGIBLE
}

enum EquipmentMaintenance {
  AVAILABLE
  IN_PROGRESS
  AWAITING_APPROVAL
}

enum ServiceAvailability {
  AVAILABLE
  DEGRADED
  OUTAGE
}

enum UserRole {
  ADMINISTRATOR
  SUPERVISOR
  MAINTENANCE_ENGINEER
}

enum FailoverAction {
  AUTOMATIC_FAILOVER
  MANUAL_FAILBACK
  PLANNED_MAINTENANCE
}

enum MaintenanceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}
enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  COMPONENT_REPLACEMENT
  EQUIPMENT_REPLACEMENT
}
enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  VERIFICATION
  COMPLETED
  ON_HOLD
  CANCELLED
  REJECTED
}
enum ChecklistResult {
  PASSED
  FAILED
  NOT_APPLICABLE
}

enum FailoverResult {
  SUCCESS
  NO_HEALTHY_STANDBY
  BLOCKED
}

enum AlarmLevel {
  INFORMATION
  WARNING
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  DETECTED
  ACKNOWLEDGED
  ASSIGNED
  UNDER_INVESTIGATION
  UNDER_REPAIR
  VERIFICATION
  RESOLVED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationKind {
  ALARM_RAISED
  INCIDENT_CHANGED
  MAINTENANCE_ASSIGNED
}

enum NotificationPriority {
  INFORMATION
  WARNING
  MAJOR
  CRITICAL
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DISABLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String   @db.VarChar(100)
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  initiatedFailovers FailoverEvent[]
  confirmedDiagnoses FaultDiagnosis[]
  alarmAcknowledgements AlarmAcknowledgement[]
  assignedIncidents Incident[] @relation("IncidentAssignee")
  approvedIncidents Incident[] @relation("IncidentApprover")
  incidentEvents IncidentEvent[]
  repairRecords RepairRecord[]
  authorizedReplacements DeviceReplacement[]
  recommendationDecisions RecommendationDecision[]
  auditEvents AuditEvent[]
  createdMaintenancePlans MaintenancePlan[] @relation("PlanCreator")
  updatedMaintenancePlans MaintenancePlan[] @relation("PlanUpdater")
  assignedMaintenancePlans MaintenancePlan[] @relation("PlanEngineer")
  assignedWorkOrders MaintenanceWorkOrder[] @relation("WorkOrderEngineer")
  supervisedWorkOrders MaintenanceWorkOrder[] @relation("WorkOrderSupervisor")
  workOrderTransitions WorkOrderStatusHistory[]
  completedChecklistItems WorkOrderChecklistItem[]
  notificationRecipients NotificationRecipient[]
  notificationPreference NotificationPreference?

  @@index([role, active])
}

model NotificationEvent {
  id String @id @default(uuid()) @db.Uuid
  sourceKey String @unique @db.VarChar(180)
  kind NotificationKind
  priority NotificationPriority @default(INFORMATION)
  title String @db.VarChar(200)
  body String @db.VarChar(2000)
  deviceId String? @db.Uuid
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  recipients NotificationRecipient[]
  @@index([createdAt(sort: Desc)])
  @@index([deviceId, createdAt(sort: Desc)])
}

model NotificationRecipient {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime?
  createdAt DateTime @default(now())
  deliveries NotificationDelivery[]
  @@unique([eventId, userId])
  @@index([userId, readAt, createdAt(sort: Desc)])
}

model NotificationPreference {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled Boolean @default(true)
  minimumPriority NotificationPriority @default(INFORMATION)
  updatedAt DateTime @updatedAt
}

model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @db.Uuid
  recipient NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  channel String @default("IN_APP") @db.VarChar(24)
  status NotificationDeliveryStatus @default(PENDING)
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastAttemptAt DateTime?
  deliveredAt DateTime?
  lastError String? @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([recipientId, channel])
  @@index([status, nextAttemptAt])
}

model LogicalSystem {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique @db.VarChar(32)
  name         String              @unique @db.VarChar(100)
  availability ServiceAvailability @default(AVAILABLE)
  devices      Device[]
  failoverEvents FailoverEvent[]
  maintenancePlans MaintenancePlan[]
  workOrders MaintenanceWorkOrder[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Device {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique @db.VarChar(48)
  name            String          @db.VarChar(120)
  systemId        String          @db.Uuid
  system          LogicalSystem   @relation(fields: [systemId], references: [id], onDelete: Restrict)
  role            DeviceRole
  health          DeviceHealth    @default(HEALTHY)
  activationState ActivationState @default(STANDBY)
  maintenanceStatus EquipmentMaintenance @default(AVAILABLE)
  maintenanceEligible Boolean @default(true)
  commissionedAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  telemetry       TelemetryReading[]
  heartbeats      Heartbeat[]
  failoversFrom   FailoverEvent[] @relation("FailoverFrom")
  failoversTo     FailoverEvent[] @relation("FailoverTo")
  diagnoses       FaultDiagnosis[]
  alarms          Alarm[]
  incidents       Incident[]
  replacements    DeviceReplacement[]
  recommendationDecisions RecommendationDecision[]
  maintenancePlans MaintenancePlan[]
  workOrders MaintenanceWorkOrder[]
  notificationEvents NotificationEvent[]

  @@unique([systemId, role])
  @@index([systemId, activationState])
}

model FaultDiagnosis {
  id                 String    @id @default(uuid()) @db.Uuid
  deviceId           String    @db.Uuid
  device             Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  ruleCode           String    @db.VarChar(64)
  suspectedCause     String    @db.VarChar(250)
  component          String    @db.VarChar(100)
  severity           String    @db.VarChar(16)
  symptoms           Json
  supportingTelemetry Json
  serviceImpact      String    @db.VarChar(250)
  investigationSteps Json
  recoveryAction     String    @db.VarChar(250)
  detectedAt         DateTime
  firstObservedAt    DateTime?
  lastSeenAt         DateTime
  resolvedAt         DateTime?
  confirmedRootCause String?   @db.VarChar(500)
  confirmedById      String?   @db.Uuid
  confirmedBy        User?     @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?
  simulated          Boolean   @default(true)
  alarm              Alarm?

  @@index([deviceId, detectedAt(sort: Desc)])
  @@index([resolvedAt, severity])
  @@index([detectedAt(sort: Desc)])
}

model Alarm {
  id             String     @id @default(uuid()) @db.Uuid
  sourceKey      String     @unique @db.VarChar(120)
  diagnosisId    String?    @unique @db.Uuid
  diagnosis      FaultDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: Restrict)
  deviceId       String     @db.Uuid
  device         Device     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  level          AlarmLevel
  initialLevel   AlarmLevel
  message        String     @db.VarChar(500)
  createdAt      DateTime   @default(now())
  lastEscalatedAt DateTime?
  resolvedAt     DateTime?
  simulated      Boolean    @default(true)
  acknowledgements AlarmAcknowledgement[]
  incident       Incident?

  @@index([resolvedAt, level, createdAt(sort: Desc)])
  @@index([deviceId, createdAt(sort: Desc)])
}

model Incident {
  id            String           @id @default(uuid()) @db.Uuid
  alarmId       String           @unique @db.Uuid
  alarm         Alarm            @relation(fields: [alarmId], references: [id], onDelete: Restrict)
  deviceId      String           @db.Uuid
  device        Device           @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  status        IncidentStatus   @default(DETECTED)
  priority      IncidentPriority
  description   String           @db.VarChar(500)
  assignedToId  String?          @db.Uuid
  assignedTo    User?            @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  approvedById  String?          @db.Uuid
  approvedBy    User?            @relation("IncidentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  acknowledgedAt DateTime?
  repairStartedAt DateTime?
  repairCompletedAt DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  events        IncidentEvent[]
  repairs       RepairRecord[]
  replacements  DeviceReplacement[]
  workOrders MaintenanceWorkOrder[]

  @@index([status, createdAt(sort: Desc)])
  @@index([deviceId, createdAt(sort: Desc)])
  @@index([assignedToId, status])
  @@index([createdAt(sort: Desc)])
}

model IncidentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  kind       String   @db.VarChar(32)
  detail     String   @db.VarChar(2000)
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model RepairRecord {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  actorId    String   @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(2000)
  spareParts String[] @default([])
  cost       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([createdAt(sort: Desc)])
}

model DeviceReplacement {
  id             String   @id @default(uuid()) @db.Uuid
  deviceId       String   @db.Uuid
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  incidentId     String?  @db.Uuid
  incident       Incident? @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  oldUnitSerial  String   @db.VarChar(100)
  newUnitSerial  String   @db.VarChar(100)
  reason         String   @db.VarChar(2000)
  cost           Decimal  @default(0) @db.Decimal(12, 2)
  authorizedById String   @db.Uuid
  authorizedBy   User     @relation(fields: [authorizedById], references: [id], onDelete: Restrict)
  replacedAt     DateTime @default(now())

  @@unique([deviceId, newUnitSerial])
  @@index([deviceId, replacedAt(sort: Desc)])
  @@index([replacedAt(sort: Desc)])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorRole  UserRole
  method     String   @db.VarChar(8)
  path       String   @db.VarChar(300)
  statusCode Int
  occurredAt DateTime @default(now())

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([statusCode, occurredAt(sort: Desc)])
}

model RecommendationDecision {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String   @db.Uuid
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  causeKey      String   @db.VarChar(200)
  evidenceHash  String   @db.Char(64)
  action        String   @db.VarChar(40)
  decision      String   @db.VarChar(16)
  note          String   @db.VarChar(2000)
  decidedById   String   @db.Uuid
  decidedBy     User     @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime @default(now())

  @@unique([deviceId, causeKey, evidenceHash])
  @@index([deviceId, decidedAt(sort: Desc)])
}

model AlarmAcknowledgement {
  id             String   @id @default(uuid()) @db.Uuid
  alarmId        String   @db.Uuid
  alarm          Alarm    @relation(fields: [alarmId], references: [id], onDelete: Restrict)
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  acknowledgedAt DateTime @default(now())

  @@unique([alarmId, userId])
  @@index([userId, acknowledgedAt(sort: Desc)])
}

model FailoverEvent {
  id              String          @id @default(uuid()) @db.Uuid
  systemId        String          @db.Uuid
  system          LogicalSystem   @relation(fields: [systemId], references: [id], onDelete: Restrict)
  fromDeviceId    String?         @db.Uuid
  fromDevice      Device?         @relation("FailoverFrom", fields: [fromDeviceId], references: [id], onDelete: Restrict)
  toDeviceId      String?         @db.Uuid
  toDevice        Device?         @relation("FailoverTo", fields: [toDeviceId], references: [id], onDelete: Restrict)
  initiatedById   String?         @db.Uuid
  initiatedBy     User?           @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  action          FailoverAction
  result          FailoverResult
  reason          String          @db.VarChar(300)
  detectedAt      DateTime
  completedAt     DateTime
  durationMs      Int
  simulated       Boolean         @default(true)

  @@index([systemId, detectedAt(sort: Desc)])
  @@index([result, detectedAt(sort: Desc)])
}

model TelemetryReading {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String   @db.Uuid
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  recordedAt    DateTime @default(now())
  temperatureC  Float?
  cpuPercent    Float?
  memoryPercent Float?
  diskPercent   Float?
  latencyMs     Float?
  packetLossPct Float?
  voltageV      Float?
  currentA      Float?
  fanRpm        Float?
  batteryPct    Float?
  signalPct     Float?
  simulated     Boolean  @default(true)

  @@index([deviceId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@unique([deviceId, recordedAt])
}

model Heartbeat {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  recordedAt DateTime @default(now())
  simulated  Boolean  @default(true)

  @@index([deviceId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@unique([deviceId, recordedAt])
}

model WeatherObservation {
  id                String   @id @default(uuid()) @db.Uuid
  station           String   @db.VarChar(4)
  observedAt        DateTime
  fetchedAt         DateTime
  rawMetar          String   @db.Text
  temperatureC      Float?
  dewPointC         Float?
  visibilityMiles   Float?
  windSpeedKnots    Float?
  windDirectionDeg  Int?
  pressureHpa       Float?
  conditions        String?  @db.VarChar(120)

  @@unique([station, observedAt])
  @@index([station, fetchedAt(sort: Desc)])
}

model MaintenancePlan {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(140)
  deviceId String @db.Uuid
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  systemId String @db.Uuid
  system LogicalSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)
  category String @db.VarChar(100)
  description String @db.VarChar(2000)
  checklist Json
  frequency MaintenanceFrequency
  customIntervalDays Int?
  advanceNoticeDays Int @default(7)
  estimatedDurationMinutes Int
  priority WorkOrderPriority @default(MEDIUM)
  assignedEngineerId String? @db.Uuid
  assignedEngineer User? @relation("PlanEngineer", fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  active Boolean @default(true)
  lastCompletedAt DateTime?
  nextScheduledAt DateTime
  createdById String @db.Uuid
  createdBy User @relation("PlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String @db.Uuid
  updatedBy User @relation("PlanUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workOrders MaintenanceWorkOrder[]
  @@index([active, nextScheduledAt])
  @@index([deviceId, active])
}

model MaintenanceWorkOrder {
  id String @id @default(uuid()) @db.Uuid
  occurrenceKey String @unique @db.VarChar(180)
  title String @db.VarChar(200)
  deviceId String @db.Uuid
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  systemId String @db.Uuid
  system LogicalSystem @relation(fields: [systemId], references: [id], onDelete: Restrict)
  planId String? @db.Uuid
  plan MaintenancePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  incidentId String? @db.Uuid
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  type WorkOrderType
  priority WorkOrderPriority
  description String @db.VarChar(2000)
  status WorkOrderStatus @default(DRAFT)
  assignedEngineerId String? @db.Uuid
  assignedEngineer User? @relation("WorkOrderEngineer", fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  supervisorId String? @db.Uuid
  supervisor User? @relation("WorkOrderSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  scheduledStartAt DateTime?
  scheduledCompletionAt DateTime?
  actualStartAt DateTime?
  actualCompletionAt DateTime?
  estimatedDurationMinutes Int
  estimatedCost Decimal @default(0) @db.Decimal(12,2)
  laborCost Decimal @default(0) @db.Decimal(12,2)
  otherCost Decimal @default(0) @db.Decimal(12,2)
  findings String? @db.VarChar(4000)
  verificationResult String? @db.VarChar(4000)
  maintenanceModeAt DateTime?
  completedAt DateTime?
  cancellationReason String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  checklistItems WorkOrderChecklistItem[]
  transitions WorkOrderStatusHistory[]
  parts WorkOrderPartUsage[]
  @@index([status, scheduledStartAt])
  @@index([deviceId, status])
  @@index([systemId, status])
  @@index([assignedEngineerId, status])
}

model WorkOrderChecklistItem {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @db.Uuid
  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  description String @db.VarChar(500)
  completed Boolean @default(false)
  result ChecklistResult?
  remarks String? @db.VarChar(2000)
  completedAt DateTime?
  completedById String? @db.Uuid
  completedBy User? @relation(fields: [completedById], references: [id], onDelete: SetNull)
  @@index([workOrderId, completed])
}

model WorkOrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @db.Uuid
  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  fromStatus WorkOrderStatus?
  toStatus WorkOrderStatus
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  note String? @db.VarChar(2000)
  createdAt DateTime @default(now())
  @@index([workOrderId, createdAt])
}

model WorkOrderPartUsage {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @db.Uuid
  workOrder MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  partName String @db.VarChar(200)
  partNumber String? @db.VarChar(100)
  quantity Int
  unitCost Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  @@index([workOrderId])
}
