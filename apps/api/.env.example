DATABASE_URL="postgresql://aeropulse:change-me@localhost:5432/aeropulse?schema=public"
PORT=4000
INSTANCE_ID=local
# Leave REDIS_URL unset for local single-instance development.
# Docker compose supplies redis://redis:6379 and uses this key to elect one job leader.
# REDIS_URL=redis://127.0.0.1:6379
LEADER_LOCK_KEY=aeropulse:leader
LEADER_LOCK_TTL_MS=10000
LEADER_RENEW_MS=3000
HEARTBEAT_MISSED_LIMIT=3
DIAG_TEMPERATURE_C=70
DIAG_FAN_RPM=900
DIAG_CPU_PERCENT=85
DIAG_MEMORY_PERCENT=85
DIAG_LATENCY_MS=120
DIAG_PACKET_LOSS_PCT=10
DIAG_MIN_VOLTAGE_V=190
DIAG_DISK_PERCENT=90
ALARM_ESCALATE_AFTER_MS=120000
RECOMMENDATION_WINDOW_DAYS=30
RECOMMENDATION_MONITOR_AT=2
RECOMMENDATION_INVESTIGATE_AT=3
RECOMMENDATION_COMPONENT_AT=4
RECOMMENDATION_REPLACEMENT_AT=5
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
# Set these only while running auth:bootstrap, then remove them from .env:
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="choose-a-unique-long-password"
