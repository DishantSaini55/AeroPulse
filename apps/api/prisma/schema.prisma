generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceRole {
  PRIMARY
  SECONDARY
}

enum DeviceHealth {
  HEALTHY
  DEGRADED
  UNAVAILABLE
  RECOVERING
}

enum ActivationState {
  ACTIVE
  STANDBY
  INELIGIBLE
}

enum ServiceAvailability {
  AVAILABLE
  DEGRADED
  OUTAGE
}

enum UserRole {
  ADMINISTRATOR
  SUPERVISOR
  MAINTENANCE_ENGINEER
}

enum FailoverAction {
  AUTOMATIC_FAILOVER
  MANUAL_FAILBACK
}

enum FailoverResult {
  SUCCESS
  NO_HEALTHY_STANDBY
  BLOCKED
}

enum AlarmLevel {
  INFORMATION
  WARNING
  MAJOR
  CRITICAL
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String   @db.VarChar(100)
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  initiatedFailovers FailoverEvent[]
  confirmedDiagnoses FaultDiagnosis[]
  alarmAcknowledgements AlarmAcknowledgement[]

  @@index([role, active])
}

model LogicalSystem {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique @db.VarChar(32)
  name         String              @unique @db.VarChar(100)
  availability ServiceAvailability @default(AVAILABLE)
  devices      Device[]
  failoverEvents FailoverEvent[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Device {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique @db.VarChar(48)
  name            String          @db.VarChar(120)
  systemId        String          @db.Uuid
  system          LogicalSystem   @relation(fields: [systemId], references: [id], onDelete: Restrict)
  role            DeviceRole
  health          DeviceHealth    @default(HEALTHY)
  activationState ActivationState @default(STANDBY)
  commissionedAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  telemetry       TelemetryReading[]
  heartbeats      Heartbeat[]
  failoversFrom   FailoverEvent[] @relation("FailoverFrom")
  failoversTo     FailoverEvent[] @relation("FailoverTo")
  diagnoses       FaultDiagnosis[]
  alarms          Alarm[]

  @@unique([systemId, role])
  @@index([systemId, activationState])
}

model FaultDiagnosis {
  id                 String    @id @default(uuid()) @db.Uuid
  deviceId           String    @db.Uuid
  device             Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  ruleCode           String    @db.VarChar(64)
  suspectedCause     String    @db.VarChar(250)
  component          String    @db.VarChar(100)
  severity           String    @db.VarChar(16)
  symptoms           Json
  supportingTelemetry Json
  serviceImpact      String    @db.VarChar(250)
  investigationSteps Json
  recoveryAction     String    @db.VarChar(250)
  detectedAt         DateTime
  lastSeenAt         DateTime
  resolvedAt         DateTime?
  confirmedRootCause String?   @db.VarChar(500)
  confirmedById      String?   @db.Uuid
  confirmedBy        User?     @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?
  simulated          Boolean   @default(true)
  alarm              Alarm?

  @@index([deviceId, detectedAt(sort: Desc)])
  @@index([resolvedAt, severity])
}

model Alarm {
  id             String     @id @default(uuid()) @db.Uuid
  sourceKey      String     @unique @db.VarChar(120)
  diagnosisId    String?    @unique @db.Uuid
  diagnosis      FaultDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: Restrict)
  deviceId       String     @db.Uuid
  device         Device     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  level          AlarmLevel
  initialLevel   AlarmLevel
  message        String     @db.VarChar(500)
  createdAt      DateTime   @default(now())
  lastEscalatedAt DateTime?
  resolvedAt     DateTime?
  simulated      Boolean    @default(true)
  acknowledgements AlarmAcknowledgement[]

  @@index([resolvedAt, level, createdAt(sort: Desc)])
  @@index([deviceId, createdAt(sort: Desc)])
}

model AlarmAcknowledgement {
  id             String   @id @default(uuid()) @db.Uuid
  alarmId        String   @db.Uuid
  alarm          Alarm    @relation(fields: [alarmId], references: [id], onDelete: Restrict)
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  acknowledgedAt DateTime @default(now())

  @@unique([alarmId, userId])
  @@index([userId, acknowledgedAt(sort: Desc)])
}

model FailoverEvent {
  id              String          @id @default(uuid()) @db.Uuid
  systemId        String          @db.Uuid
  system          LogicalSystem   @relation(fields: [systemId], references: [id], onDelete: Restrict)
  fromDeviceId    String?         @db.Uuid
  fromDevice      Device?         @relation("FailoverFrom", fields: [fromDeviceId], references: [id], onDelete: Restrict)
  toDeviceId      String?         @db.Uuid
  toDevice        Device?         @relation("FailoverTo", fields: [toDeviceId], references: [id], onDelete: Restrict)
  initiatedById   String?         @db.Uuid
  initiatedBy     User?           @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  action          FailoverAction
  result          FailoverResult
  reason          String          @db.VarChar(300)
  detectedAt      DateTime
  completedAt     DateTime
  durationMs      Int
  simulated       Boolean         @default(true)

  @@index([systemId, detectedAt(sort: Desc)])
  @@index([result, detectedAt(sort: Desc)])
}

model TelemetryReading {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String   @db.Uuid
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  recordedAt    DateTime @default(now())
  temperatureC  Float?
  cpuPercent    Float?
  memoryPercent Float?
  diskPercent   Float?
  latencyMs     Float?
  packetLossPct Float?
  voltageV      Float?
  currentA      Float?
  fanRpm        Float?
  batteryPct    Float?
  signalPct     Float?
  simulated     Boolean  @default(true)

  @@index([deviceId, recordedAt(sort: Desc)])
  @@index([recordedAt])
}

model Heartbeat {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  recordedAt DateTime @default(now())
  simulated  Boolean  @default(true)

  @@index([deviceId, recordedAt(sort: Desc)])
  @@index([recordedAt])
}

model WeatherObservation {
  id                String   @id @default(uuid()) @db.Uuid
  station           String   @db.VarChar(4)
  observedAt        DateTime
  fetchedAt         DateTime
  rawMetar          String   @db.Text
  temperatureC      Float?
  dewPointC         Float?
  visibilityMiles   Float?
  windSpeedKnots    Float?
  windDirectionDeg  Int?
  pressureHpa       Float?
  conditions        String?  @db.VarChar(120)

  @@unique([station, observedAt])
  @@index([station, fetchedAt(sort: Desc)])
}
